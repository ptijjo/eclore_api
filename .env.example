PORT=8000

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/eclore?schema=public"

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=default
REDIS_PASSWORD=

JWT_ACCESS_SECRET="change-me-access-secret-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-secret-min-32-chars"
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d
AUTH_MAX_SESSIONS=3
BCRYPT_ROUNDS=12

API_PUBLIC_URL="http://localhost:8000"
EMAIL_VERIFY_TTL_HOURS=48
PASSWORD_RESET_TTL_HOURS=1
TERMS_VERSION=1.0
ANONYMITY_ACK_VERSION=1.0

MJ_APIKEY_PUBLIC=
MJ_APIKEY_PRIVATE=
MAILJET_SENDER_EMAIL=
MAILJET_SENDER_NAME=Eclore

JOIN_REQUEST_COOLDOWN_SECONDS=3600

# Cloudflare R2 (stockage audio privé — URLs signées à TTL court)
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET_NAME=
CLOUDFLARE_R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# Domaine public éventuel (avatars, etc.) — ne pas servir les témoignages vocaux via cette URL
CLOUDFLARE_R2_PUBLIC_BASE_URL=
MEDIA_MAX_BYTES=10000000
MEDIA_MAX_DURATION_MS=180000
MEDIA_SIGNED_URL_TTL_SECONDS=60

# Compte admin (prisma db seed)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@eclore.local
ADMIN_PASSWORD=
